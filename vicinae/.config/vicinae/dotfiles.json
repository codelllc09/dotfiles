{
  "$schema": "https://vicinae.com/schemas/config.json",
  "telemetry": {
    "system_info": false
  },
  "launcher_window": {
    "compact_mode": {
      "enabled": true
    },
    "clock": {
      "enabled": false
    },
    "size": {
      "width": 770,
      "height": 320
    }
  },
  "theme": {
    "light": {
      "name": "rose-pine"
    }
  },
  "keybinding": "emacs",
  "escape_key_behavior": "close_window",
  "close_on_focus_loss": true,
  "pop_to_root_on_close": true
}