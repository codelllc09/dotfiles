emacs/.emacs.d/auto-save-list/
emacs/.emacs.d/auto-saves/
emacs/.emacs.d/state/
emacs/.emacs.d/url/
emacs/.emacs.d/history
emacs/.emacs.d/recentf
emacs/.emacs.d/places
emacs/.emacs.d/tools/node/node_modules/
