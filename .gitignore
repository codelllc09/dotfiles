# 執行期產物 / 敏感內容不入庫
*.log
*.tmp
/bash/.config/bash/secret.bash
# rime 用戶資料庫（將來收編 rime 包時）
*.userdb/
*.userdb
installation.yaml

# Emacs 只收配置；下載、編譯、狀態與機器專屬輸出不入庫
emacs/.emacs.d/custom.el
emacs/.emacs.d/elpa/
emacs/.emacs.d/eln-cache/
emacs/.emacs.d/tree-sitter/
emacs/.emacs.d/debug-adapters/
emacs/.emacs.d/vendor/
emacs/.emacs.d/backups/
emacs/.emacs.d/auto-save-list/
emacs/.emacs.d/auto-saves/
emacs/.emacs.d/state/
emacs/.emacs.d/url/
emacs/.emacs.d/history
emacs/.emacs.d/recentf
emacs/.emacs.d/places
emacs/.emacs.d/tools/node/node_modules/
emacs/.emacs.d/tools/python/
emacs/.emacs.d/tools/lua-ls/
emacs/.emacs.d/tools/*.tar.gz

# Yazi 只收配置與插件清單；插件本體由 ya pkg 下載（若被誤拷進包目錄亦忽略）
yazi/.config/yazi/plugins/

# Vicinae 只收 settings 與 scripts；數據庫/索引/主題/snippets 屬 state（誤拷進包亦忽略）
vicinae/.local/share/vicinae/*
!vicinae/.local/share/vicinae/scripts/
