#!/usr/bin/env bash
# gsel: 從 GPaste 剪貼板歷史選一條,設爲當前系統剪貼板(帶確認反饋)。
# 之後用 終端 Ctrl+Shift+V / Emacs p 粘貼。
idx=$(gpaste-client --oneline --use-index \
  | fzf --height=40% --reverse --delimiter ':' \
        --header='Enter=設爲剪貼板  Alt+D=刪除該條  Esc=取消' \
        --bind 'alt-d:reload(gpaste-client --use-index delete {1} >/dev/null; gpaste-client --oneline --use-index)' \
  | sed -n 's/^\([0-9]*\):.*/\1/p')

if [ -z "$idx" ]; then
  echo '(未選擇,剪貼板未變)'
  exit 0
fi
if gpaste-client --use-index select "$idx"; then
  echo "✓ 第 ${idx} 條已設爲當前剪貼板 → Ctrl+Shift+V(終端)或 p(Emacs)粘貼"
fi
